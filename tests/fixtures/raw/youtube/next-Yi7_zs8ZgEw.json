}}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}]}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0}},"showMoreText":{"simpleText":"...더보기"},"showLessText":{"simpleText":"간략히"},"defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"commandExecutorCommand":{"commands":[{"changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"가야공인중개사 박홍균 블로그: https://blog.naver.com/gayayangpyeong\n\n양평 지평면 일신리 남향 전원주택 매매 3억 5,000만원 (매물번호 350)\n잔디마당 넓은 2층 단독주택, 토지 677㎡(205평), 건물 175㎡(53평)\n\n공기 좋고 물 맑은 양평에서 전원생활을 꿈꾸고 계신가요?\n실거주는 물론, 주말마다 쉬러 오실 세컨하우스를 찾는 분들의 문의가 정말 많은데요.\n오늘은 소나무와 잔디가 잘 가꿔진 마당, 햇살 잘 드는 남향 거실, 들판이 내려다보이는 2층 테라스까지 갖춘\n지평면 일신리 전원주택을 구석구석 보여 드립니다.\n영상 끝까지 시청해 주시고, 구독과 좋아요, 알림 설정은 저희에게 큰 힘이 됩니다.\n\n-------------------------------------\n◑ 매물번호 : 350\n◑ 소재지 : 경기도 양평군 지평면 일신리 (상세주소는 문의 시 안내)\n◑ 매물종류 : 전원주택 (지상 2층 단독주택)\n◑ 거래형태 : 매매\n◑ 매매가 : 3억 5,000만원\n◑ 토지면적 : 677㎡ (205평) + 도로지분 76㎡ (23평)\n◑ 건축면적 : 1층 125㎡ (38평), 2층 50㎡ (15평), 합계 175㎡ (53평)\n◑ 방/욕실 : 방3 (1층 2, 2층 1) / 욕실 1층2 (안방 1, 공용 1)2층1\n◑ 난방 : 심야전기 보일러 + 화목난로\n◑ 방향(거실창 기준) : 남향\n◑ 주차대수 : 2대\n-------------------------------------\n\n소나무와 잔디가 어우러진 넓은 마당\n\n햇살 가득한 남향 거실, 큰 창으로 보이는 산과 들\n들판이 내려다보이는 2층 테라스 데크\n겨울이 즐거운 화목난로\n유실수와 조경수가 잘 가꿔진 정원\n물고기가 사는 인근 하천, 취미생활 가능\n햇살 잘 드는 양지 바른 마을\n제2영동고속도로 동여주IC 차량 약 10분, 분당·강남·송파 접근성 좋은 편\n토목, 건축, 조경은 겸업하는 일치건축에서 함께 상담\n\n-------------------------------------\n상            호 : 가야공인중개사\n주            소 : 경기도 양평군 지평면 지평의병로 32\n등 록 번 호  : 가-3644-198\n대 표 전 화  : 010-3406-0071\n대           표 : 박홍균 공인중개사\n1998년부터 지평에서 영업하고 있습니다.\n-------------------------------------\n\n면적과 가격은 매도인 제공 자료 기준이며, 계약 전 등기사항증명서와 건축물대장으로 확인하시기 바랍니다.\n\n#양평전원주택 #지평면전원주택 #일신리전원주택 #양평전원주택매매 #양평주택매매 #양평단독주택 #전원주택매매 #세컨하우스 #양평부동산 #지평부동산 #가야공인중개사 #가야부동산 #양평가야부동산","commandRuns":[{"startIndex":17,"length":37,"onTap":{"innertubeCommand":{"commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description&redir_token=QUZZTVljRnhWNFNsc01CbU84cU1vX1JQTnExeHxBSTVJdTV1WlVvMC1MZ3Atd3d5NDc0ZFo1NzVLanpqNjNjbXg3Z3lYSWUzVWxxX2ZGWkRYUkdjQU01OGZuOVdiY29ZUUlia3V2VHdmR0VtTFFrTEZEREN5RUY4WkhUYk5QSkt4&q=https%3A%2F%2Fblog.naver.com%2Fgayayangpyeong&v=Yi7_zs8ZgEw","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description&redir_token=QUZZTVljRnhWNFNsc01CbU84cU1vX1JQTnExeHxBSTVJdTV1WlVvMC1MZ3Atd3d5NDc0ZFo1NzVLanpqNjNjbXg3Z3lYSWUzVWxxX2ZGWkRYUkdjQU01OGZuOVdiY29ZUUlia3V2VHdmR0VtTFFrTEZEREN5RUY4WkhUYk5QSkt4&q=https%3A%2F%2Fblog.naver.com%2Fgayayangpyeong&v=Yi7_zs8ZgEw","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":1256,"length":7,"onTap":{"innertubeCommand":{"commandMetadata":{"webCommandMetadata":{"url":"/hashtag/%EC%96%91%ED%8F%89%EC%A0%84%EC%9B%90%EC%A3%BC%ED%83%9D","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUWChLslpHtj4nsoITsm5Dso7ztg50YAQ%3D%3D"}}},"loggingDirectives":{}},{"startIndex":1264,"length":8,"onTap":{"innertubeCommand":{"commandMetadata":{"webCommandMetadata":{"url":"/hashtag/%EC%A7%80%ED%8F%89%EB%A9%B4%EC%A0%84%EC%9B%90%EC%A3%BC%ED%83%9D","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUZChXsp4Dtj4nrqbTsoITsm5Dso7ztg50YAQ%3D%3D"}}},"loggingDirectives":{}},{"startIndex":1273,"length":8,"onTap":{"innertubeCommand":{"commandMetadata":{"webCommandMetadata":{"url":"/hashtag/%EC%9D%BC%EC%8B%A0%EB%A6%AC%EC%A0%84%EC%9B%90%EC%A3%BC%ED%83%9D","webPageType":"WEB