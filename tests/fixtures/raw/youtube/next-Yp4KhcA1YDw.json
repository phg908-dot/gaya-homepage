opup":{"confirmDialogRenderer":{"dialogMessages":[{"runs":[{"text":"가야공인중개사 박홍균"},{"text":" 구독을 취소하시겠습니까?"}]}],"confirmButton":{"buttonRenderer":{"style":"STYLE_BLUE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"구독 취소"}]},"serviceEndpoint":{"commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/unsubscribe"}},"unsubscribeEndpoint":{"channelIds":["UCNp6hmVYKNm5Cxv4bw56r9w"],"params":"CgIIAxILWXA0S2hjQTFZRHcYAA%3D%3D"}},"accessibility":{"label":"구독 취소"}}},"cancelButton":{"buttonRenderer":{"style":"STYLE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"취소"}]},"accessibility":{"label":"취소"}}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}]}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0}},"showMoreText":{"simpleText":"...더보기"},"showLessText":{"simpleText":"간략히"},"defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"commandExecutorCommand":{"commands":[{"changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"글로 자세히 보기(블로그): https://blog.naver.com/gayayangpyeong...\n\n양평토지 매물, 양평군 지평면 지평리 시내 토지(지목 대지) 330㎡(100평)을 1억 2천만 원에 사실 수 있습니다. 도로 지분을 포함한 면적입니다.\n전체 660㎡(200평)를 절반으로 나눈 뒤쪽 땅으로, 지평역까지 걸어서 450m, 포장 진입도로가 바로 앞까지 옵니다.\n\n◑ 소재지 : 경기도 양평군 지평면 지평리 (지평 시내)\n◑ 매물종류 : 토지, 지목 대지 (전체 660㎡(200평)를 절반으로 나눈 뒤쪽)\n◑ 면적 : 330㎡(100평), 도로 지분 포함\n◑ 매매가 : 1억 2,000만 원 (전체로 사시면 660㎡(200평) 2억 3,000만 원)\n◑ 용도지역 : 도시지역, 제1종 주거지역\n◑ 건폐율 60%, 용적률 200%\n◑ 진입도로 : 폭 6m 포장, 뒤쪽 땅 바로 앞까지\n◑ 방향 : 남향\n◑ 기반시설 : 상수도, 하수도 관로 연결\n◑ 생활권 : 지평역 걸어서 450m. 학교, 병원, 하나로마트, 면사무소 걸어서 500m 안쪽\n\n꼭 확인해 주십시오\n1. 660㎡(200평)와 330㎡(100평)는 도로 지분을 합친 면적입니다. 영상의 노란 선은 대지 부분, 파란색은 진입도로입니다.\n2. 영상의 경계선은 지적도를 옮겨 그린 참고용입니다. 정확한 경계는 측량으로 확인합니다.\n3. 분할 매매는 분할 측량과 절차를 거칩니다.\n4. 건축 규모와 가능 여부는 설계와 양평군청 허가 과정에서 확인합니다.\n5. 매매 조건과 가격은 매도인 사정에 따라 바뀌거나 거래가 끝날 수 있습니다.\n\n상호 가야공인중개사\n소재지 경기도 양평군 지평면 지평의병로 32\n연락처 010-3406-0071\n등록번호 가-3644-198\n대표 박홍균 공인중개사\n\n#양평토지 #지평면토지 #양평전원주택 #지평역전원주택 #양평땅 #1억대토지 #양평소액토지 #분할매매 #양평부동산 #가야공인중개사","commandRuns":[{"startIndex":16,"length":40,"onTap":{"innertubeCommand":{"commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description&redir_token=QUZZTVljRW93NFo0NENHbXJLWTBmeS0xTEFUX3xBSTVJdTV1N0Y2SzRBXzNXVFd3RWExYUVlMU44MzNTdG9wbUdZVHlqbkdfcUtFYjNVN3lBRmtiOTZPcVFEckUycHo1Um9BbjlmZlE3X1dMQ1BQOElhTnA0YlpzQXJUY3RaMzNf&q=https%3A%2F%2Fblog.naver.com%2Fgayayangpyeong%2F224427678503&v=Yp4KhcA1YDw","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description&redir_token=QUZZTVljRW93NFo0NENHbXJLWTBmeS0xTEFUX3xBSTVJdTV1N0Y2SzRBXzNXVFd3RWExYUVlMU44MzNTdG9wbUdZVHlqbkdfcUtFYjNVN3lBRmtiOTZPcVFEckUycHo1Um9BbjlmZlE3X1dMQ1BQOElhTnA0YlpzQXJUY3RaMzNf&q=https%3A%2F%2Fblog.naver.com%2Fgayayangpyeong%2F224427678503&v=Yp4KhcA1YDw","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":870,"length":5,"onTap":{"innertubeCommand":{"commandMetadata":{"webCommandMetadata":{"url":"/hashtag/%EC%96%91%ED%8F%89%ED%86%A0%EC%A7%80","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUQCgzslpHtj4nthqDsp4AYAQ%3D%3D"}}},"loggingDirectives":{}},{"startIndex":876,"length":6,"onTap":{"innertubeCommand":{"commandMetadata":{"webCommandMetadata":{"url":"/hashtag/%EC%A7%80%ED%8F%89%EB%A9%B4%ED%86%A0%EC%A7%80","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUTCg_sp4Dtj4nrqbTthqDsp4AYAQ%3D%3D"}}},"loggi